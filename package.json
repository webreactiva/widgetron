{
  "name": "widgetron-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @webreactiva/playground dev",
    "dev:studio": "pnpm --filter @webreactiva/story-studio dev",
    "story": "pnpm --filter @webreactiva/story-studio story",
    "build": "pnpm --filter @webreactiva/widgetron build",
    "build:playground": "pnpm --filter @webreactiva/playground build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm -r typecheck && pnpm -r test && pnpm build",
    "registry:build": "pnpm --filter @webreactiva/registry build",
    "wiki": "node scripts/wiki/wiki.mjs",
    "wiki:drift": "node scripts/wiki/wiki.mjs drift",
    "wiki:coverage": "node scripts/wiki/wiki.mjs coverage",
    "wiki:lint": "node scripts/wiki/wiki.mjs lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
